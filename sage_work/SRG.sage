def DS_4_medium(input_raw):
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    matgraphs = [G.delete_rows([0]).delete_columns([0]) for G in matgraphs]
    cospectra_3 = []
    M = len(matgraphs)

    print("Generating single child cospectra...")
    for i in range(M):
        cospectra_3.append(cospectrum(matgraphs[i],3))
        print(str(i+1)+"/"+str(M))
    
    
    for i in range(M):
        for j in range(i+1,M):
            if cospectra_3[i] == cospectra_3[j]:
                print("Further investigation required")    
            print(i,j,M)

def export_string_to_file(string, filename):
    with open(filename, 'w') as file:
        file.write(string)
    print(f"String has been exported to {filename}")

def random_DS_4(input_raw):
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    M = len(matgraphs)
    
    for i in range(M):
        for j in range(i+1,M):
            if random_cosp_test(matgraphs[i],matgraphs[j],4)[0] == True:
                print("Disproven!")    
            print(i+1,j+1,M)

def DE_4(input_raw):
    max_size = 26
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    M = len(matgraphs)

    rounds = ceil(M/max_size)
    for round in range(rounds-1):###last round separate
        if round < 1: #completed round 1
            continue
        print("round ",round+1,"/",rounds)
        thingies = []
        for i in range(round*max_size,(round+1)*max_size):
            start = time.time()
            thingies.append(simple_tree(matgraphs[i],4,edge_count))
            print("stored "+str(i+1)+"/"+str(max_size),time.time()-start)
        for i in range(max_size):
            c = thingies[i]
            for j in range(i+1,max_size):
                if c == thingies[j]:
                    print("Disproven!")    
                print(i+1,j+1,max_size)
        for i in range((round+1)*max_size,M):
            c = simple_tree(matgraphs[i],4,edge_count)
            for j in range(len(thingies)):
                if c == thingies[j]:
                    print("Disproven!")
                print(i+1,j+1,M)
    
    print("round ",rounds,"/",rounds)
    thingies = []
    size = M-((rounds-1)*max_size)
    for i in range((rounds-1)*max_size,M):
        start = time.time()
        thingies.append(simple_tree(matgraphs[i],4,edge_count))
        print("stored "+str(i+1)+"/"+str(M),time.time()-start)
    for i in range(size):
            c = thingies[i]
            for j in range(i+1,size):
                if c == thingies[j]:
                    print("Disproven!") 

def DDS_3(input_raw):
    max_size = 60
    # checkpoint_round, checkpoint_num = 10,141

    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    M = len(matgraphs)

    rounds = ceil(M/max_size)
    for round in range(rounds-1):###last round separate
        # if round+1<checkpoint_round:######################################
        #     continue
        print("round ",round+1,"/",rounds)
        thingies = []
        for i in range(round*max_size,(round+1)*max_size):
            start = time.time()
            thingies.append(simple_tree(matgraphs[i],2,ds_1))
            print("stored "+str(i+1)+"/"+str(max_size),time.time()-start)
        for i in range(max_size):
            c = thingies[i]
            for j in range(i+1,max_size):
                if c == thingies[j]:
                    print("Disproven!")  
                    raise TypeError("break")  
                print(i+1,j+1,max_size)
        for i in range((round+1)*max_size,M):
            # if i+1<=checkpoint_num and round+1 == checkpoint_round:####################
            #     continue
            c = simple_tree(matgraphs[i],2,ds_1)
            for j in range(len(thingies)):
                if c == thingies[j]:
                    print("Disproven!")
                    raise TypeError("break")
                print(i+1,j+1,M)
    
    print("round ",rounds,"/",rounds)
    thingies = []
    size = M-((rounds-1)*max_size)
    for i in range((rounds-1)*max_size,M):
        start = time.time()
        thingies.append(simple_tree(matgraphs[i],2,ds_1))
        print("stored "+str(i+1)+"/"+str(M),time.time()-start)
    for i in range(size):
            c = thingies[i]
            for j in range(i+1,size):
                if c == thingies[j]:
                    raise TypeError("break")
                print(i+1,j+1,size)

def DegSeq_counter(input_raw):
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    M = len(matgraphs)
    n = matgraphs[0].nrows()

    pairs = []

    for i in range(M):
        print(i+1,"/",M)
        seqs = []
        counts = []
        for tup in Combinations([t for t in range(n)],Integer(3)):
            A = degseq(matgraphs[i].delete_rows(tup).delete_columns(tup))
            if A not in seqs:
                seqs.append(A)
                counts.append(1)
            else:
                tmp = counts[seqs.index(A)]
                counts[seqs.index(A)] = tmp + 1
        pairs.append([seqs,counts])

    tmp = []
    for x in pairs:
        if x not in tmp:
            tmp.append(x)
    if len(tmp)<len(pairs):
        return(False)
    else:
        return(pairs)

def DegSeq_1_counter(input_raw, with_counts=1):
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    M = len(matgraphs)
    n = matgraphs[0].nrows()

    pairs = []

    for i in range(M):
        print(i+1,"/",M)
        seqs = []
        counts = []
        for tup in Combinations([t for t in range(n)],Integer(2)):
            A = ds_1(matgraphs[i].delete_rows(tup).delete_columns(tup))
            if A not in seqs:
                seqs.append(A)
                counts.append(1)
            else:
                tmp = counts[seqs.index(A)]
                counts[seqs.index(A)] = tmp + 1
        pairs.append([seqs,counts])

    if with_counts == 1:
        tmp = []
        for x in pairs:
            if x not in tmp:
                tmp.append(x)
        if len(tmp)<len(pairs):
            return(False)
        else:
            return(pairs)
    else:
        for i in range(len(seqs)):
            for j in range(i+1,len(seqs)):
                s = seqs[i] + seqs[j]
                tmp = []
                for x in s:
                    if x not in tmp:
                        tmp.append(x)
                if len(tmp)<len(s):
                    return(False)
    return(seqs)

def property_counter(input_raw, property, depth):
    strgraphs=extract_graph_blocks(input_raw)
    matgraphs = [binary_strings_to_sage_matrix(strgraphs[i]) for i in range(len(strgraphs))]
    # matgraphs=[matgraphs[i] for i in [176,177]]#######
    M = len(matgraphs)
    n = matgraphs[0].nrows()

    

    graph_props = []

    for i in range(M):
        print("generating ",i+1,"/",M)
        seqs = []
        counts = []
        for tup in Combinations([t for t in range(n)],Integer(depth)):
            A = property(matgraphs[i].delete_rows(tup).delete_columns(tup))
            if A not in seqs:
                seqs.append(A)
                counts.append(1)
            else:
                tmp = counts[seqs.index(A)]
                counts[seqs.index(A)] = tmp + 1
        pairs = []
        for seq in seqs:
            pairs.append([seq,counts[seqs.index(seq)]])
        pairs.sort()
        graph_props.append(pairs)

    for i in range(len(graph_props)):
        for j in range(i+1,len(graph_props)):
            seqs_i = [graph_props[i][t][0] for t in range(len(graph_props[i]))]
            seqs_j = [graph_props[j][t][0] for t in range(len(graph_props[j]))]
            distinct_with_multiplicity = bool(graph_props[i]!=graph_props[j])
            distinct_without_multiplicity = bool(seqs_i!=seqs_j)
            if not (distinct_with_multiplicity and distinct_without_multiplicity):
                print(i+1,j+1,M,distinct_with_multiplicity, distinct_without_multiplicity)
    print("end")
    


